{
  "name": "collectible-catalog-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-platform collectible catalog PWA with photo capture, comparable search links, and printable labels.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test:auth": "node scripts/auth-client-smoke.mjs",
    "test:backup": "node scripts/catalog-backup-smoke.mjs",
    "test:backend": "node scripts/backend-smoke.mjs",
    "test:catalog": "node scripts/catalog-repository-smoke.mjs",
    "test:labels": "node scripts/label-tools-smoke.mjs",
    "test:sale-listing": "node scripts/sale-listing-smoke.mjs",
    "start:api": "node server/index.mjs",
    "serve": "python -m http.server 4173 --bind 127.0.0.1"
  }
}
